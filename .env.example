# ============================================================
# Banking Agent — environment configuration
# Copy this file to `.env` and fill in your keys.
# ============================================================

# ---- LLM (required) ----
# Your gap-gpt API key goes here. If you use the gap-gpt gateway instead of
# api.openai.com, also set OPENAI_BASE_URL to their endpoint.
OPENAI_API_KEY=sk-your-gapgpt-key-here

# Example gateway base URL (use whichever your provider gives you):
#   gap-gpt style gateway:  https://api.gap-gpt.com/v1
#   leave unset to use      https://api.openai.com/v1 directly
#OPENAI_BASE_URL=https://api.gap-gpt.com/v1

# Agent model - must be excellent at Persian. gpt-4o recommended (also: gpt-4.1, gpt-4o-mini)
AGENT_MODEL=gpt-4o

# ---- Embeddings ----
# "persian" (default): local SOTA Persian model csebuetnlp/mMTEB_large_fa - free, offline
# "openai":            text-embedding-3-small (multilingual, costs per token)
EMBEDDING_PROVIDER=persian
PERSIAN_EMBEDDING_MODEL=csebuetnlp/mMTEB_large_fa
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---- Retrieval knobs (optional) ----
RAG_TOP_K=4
CHUNK_SIZE=900
CHUNK_OVERLAP=150

# ---- Data file overrides (optional; defaults point to ./data/) ----
# CUSTOMERS_FILE=./data/customers.xlsx
# CARD_ORDERS_FILE=./data/card_orders.xlsx
# POLICIES_FILE=./data/قوانین و مقررات بانک دایا_تدبیر.docx
# REQUESTS_FILE=./requests.xlsx
